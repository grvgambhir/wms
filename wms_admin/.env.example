VITE_WMS_BACKEND_URL=http://localhost:3050

# --- AWS Cognito (decision D5) ---
# Pool ID is on the pool's Overview page, e.g. eu-south-1_AbCd1234.
VITE_COGNITO_USER_POOL_ID=
# Region is the prefix of the pool id.
VITE_COGNITO_REGION=
# SPA app client "wms_admin" — public, no secret. Safe to ship in the bundle.
VITE_COGNITO_CLIENT_ID=your-admin-client-id
