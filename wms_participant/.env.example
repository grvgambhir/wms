# Nest backend — journey, rules, profile, inbox, and all authenticated reads.
EXPO_PUBLIC_WMS_BACKEND_URL=http://localhost:3050

# true = show the POC demo login (daniel.harper / OTP 123456) next to Cognito.
# Off by default so a stored demo session cannot shadow a real Cognito login.
EXPO_PUBLIC_DEMO_AUTH=false

# --- AWS Cognito (decision D5) ---
# Pool ID is on the pool's Overview page, e.g. eu-south-1_AbCd1234. FILL THIS IN.
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
# Region is the prefix of the pool id. FILL THIS IN.
EXPO_PUBLIC_COGNITO_REGION=
# SPA app client "wms_participant" — public, no secret. Safe to ship in the bundle.
EXPO_PUBLIC_COGNITO_CLIENT_ID=your-participant-client-id
