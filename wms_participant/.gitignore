*.p8
*.p12
*.key
*.mobileprovision
*.ipa
*.apk
*.aab
*.app

npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
*.log
logs/

.DS_Store
Thumbs.db
*.pem
.AppleDouble
.LSOverride

.env
.env.*
!.env.example

*.tsbuildinfo
coverage/
.nyc_output/

.idea/
*.swp
*.swo
.vscode/*
