{
  "name": "wms_backend",
  "version": "0.1.0",
  "private": true,
  "description": "Como Lake 2027 NestJS backend — replaces the temporary wms_api Express shim.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && node scripts/write-build-info.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:load": "node scripts/load-and-guarantees.mjs",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"seeds/**/*.ts\"",
    "seed": "node --env-file=.env --import tsx seeds/run.ts",
    "seed:reset": "node --env-file=.env --import tsx seeds/run.ts --reset",
    "dev:clear-entries": "node --env-file=.env --import tsx scripts/dev-clear-entries.ts",
    "format": "prettier --write .",
    "migrate:up": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations -d DATABASE_OWNER_URL",
    "migrate:down": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations -d DATABASE_OWNER_URL",
    "migrate:create": "node-pg-migrate create --migration-file-language sql -m migrations",
    "migrate:status": "node --env-file=.env --import tsx scripts/migrate-status.ts",
    "db:types": "node --env-file=.env ./node_modules/kysely-codegen/dist/cli/bin.js --dialect postgres --out-file src/db/types.ts --default-schema=public --include-pattern='+(core|restricted|ops|audit).*'",
    "plan:drift": "node --env-file=.env scripts/plan-drift.mjs",
    "token": "node --env-file=.env scripts/cognito-token.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1129.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@wms/domain": "file:../wms_domain",
    "argon2": "^0.45.1",
    "aws-jwt-verify": "^5.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "kysely-codegen": "^0.18.5",
    "node-pg-migrate": "^8.0.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
