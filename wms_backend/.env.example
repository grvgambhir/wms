# Copy to .env and adjust. These are safe local-dev defaults from docker-compose.yml.

# Runtime connection for Nest. It must use app_rw, the least-privilege application role.
DATABASE_URL=postgres://app_rw:wms_app@localhost:5433/wms_dev
# Owner-only connection for migrations and seeds; Nest never uses this URL at runtime.
DATABASE_OWNER_URL=postgres://wms:wms_dev@localhost:5433/wms_dev
# Restricted evidence pool. It must authenticate as restricted_rw and never fall back to DATABASE_URL.
# The local password is created by the restricted_rw LOGIN migration; production must set its own.
RESTRICTED_DATABASE_URL=postgres://restricted_rw:wms_restricted@localhost:5433/wms_dev

# TCP port listened to by the Nest process.
PORT=3050
# Runtime mode; use production only in a deployed environment.
NODE_ENV=development
# Minimum level emitted by the application logger.
LOG_LEVEL=info
# Optional deployment identifier. CI sets this to the commit SHA; locally Git is used when available.
# GIT_SHA=
# Optional maximum connections in the ordinary pg.Pool (default: 10).
# DATABASE_POOL_MAX=10

# Select local for offline development or cognito for deployed identity validation.
AUTH_PROVIDER=local
# Required signing secret for the local provider; use a unique secret outside local development.
JWT_SECRET=local-dev-only-change-me-32chars-min

# Required when AUTH_PROVIDER=cognito: the AWS region hosting the configured user pool.
# COGNITO_REGION=
# Required when AUTH_PROVIDER=cognito: user-pool identifier, e.g. eu-south-1_AbCdEfGhI.
# COGNITO_USER_POOL_ID=
# Required when AUTH_PROVIDER=cognito: public client ID for the participant application.
# COGNITO_CLIENT_ID_PARTICIPANT=
# Required when AUTH_PROVIDER=cognito: public client ID for the admin application.
# COGNITO_CLIENT_ID_ADMIN=

# Optional local OC-admin email used only by development seed data.
AUTH_SEED_OC_ADMIN_EMAIL=oc.admin@example.com
# Optional local OC-admin password used only by development seed data.
AUTH_SEED_OC_ADMIN_PASSWORD=dev-admin-password
# Optional local participant email used only by development seed data.
AUTH_SEED_PARTICIPANT_EMAIL=athlete@example.com
# Optional local participant password used only by development seed data.
AUTH_SEED_PARTICIPANT_PASSWORD=dev-athlete-password
# Real Cognito logins every seed (and seed:reset) must keep working — see seeds/seed-logins.ts.
# Cognito sub, never email, identifies the login. Local .env only.
# SEED_OC_ADMINS=<cognito-sub>:<email>,<cognito-sub>:<email>
SEED_OC_ADMINS=
# Link a real login to a seeded demo athlete: daniel, elena, luca, marco.
# SEED_LOGIN_LINKS=daniel:<cognito-sub>,elena:<cognito-sub>
SEED_LOGIN_LINKS=

# Optional AWS region for AdminCreateUser; defaults to COGNITO_REGION.
# AWS_REGION=
# Optional static access key. Set it together with AWS_SECRET_ACCESS_KEY, or neither.
# AWS_ACCESS_KEY_ID=
# Optional static secret key. Set it together with AWS_ACCESS_KEY_ID, or neither.
# AWS_SECRET_ACCESS_KEY=
# Optional session token paired with temporary AWS credentials.
# AWS_SESSION_TOKEN=
